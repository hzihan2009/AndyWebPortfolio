---
import { Chess } from 'chess.js';
import { featuredGame } from '../data/chess-game';
const game = new Chess();
game.loadPgn(featuredGame.pgn);
const headers = game.getHeaders();
const moves = game.history({ verbose: true });
const replay = new Chess();
const names: Record<string, string> = { k: 'king', q: 'queen', r: 'rook', b: 'bishop', n: 'knight', p: 'pawn' };
function position(label: string, from = '', to = '') {
  return { label, squares: replay.board().flat().map((piece, index) => ({
    image: piece ? '/chess/' + piece.color + piece.type + '.svg' : '',
    name: `${'abcdefgh'[index % 8]}${8 - Math.floor(index / 8)}: ${piece ? `${piece.color === 'w' ? 'White' : 'Black'} ${names[piece.type]}` : 'empty'}`,
    highlight: piece?.square === from || piece?.square === to || `${'abcdefgh'[index % 8]}${8 - Math.floor(index / 8)}` === from,
  })) };
}
const positions = [position('Starting position')];
moves.forEach((move, i) => {
  replay.move(move.san);
  positions.push(position(`${Math.floor(i / 2) + 1}${i % 2 ? '...' : '.'} ${move.san}`, move.from, move.to));
});
const initial = Math.min(featuredGame.initialPly, moves.length);
---
<figure class="board-figure game-replay" data-positions={JSON.stringify(positions)} data-initial={initial}>
  <p class="game-player">{headers.Black} <span>({headers.BlackElo})</span></p>
  <div class="board-wrap"><div class="board" role="img" aria-label={`Chess position after ${positions[initial].label}, White at the bottom`}>
    {positions[initial].squares.map((square, i) => <span class:list={['square', 'game-square', { dark: (Math.floor(i / 8) + i % 8) % 2 === 1, 'last-move': square.highlight }]} title={square.name}><img class="game-piece" src={square.image || undefined} hidden={!square.image} alt="" aria-hidden="true" /><span class="sr-only">{square.name}. </span></span>)}
  </div></div>
  <p class="game-player">Andy Hong <span>({headers.WhiteElo}) · White</span></p>
  <div class="game-controls" hidden>
    <button type="button" data-action="start" aria-label="Starting position">⇤</button>
    <button type="button" data-action="previous" aria-label="Previous move">←</button>
    <output aria-live="polite">{positions[initial].label}</output>
    <button type="button" data-action="next" aria-label="Next move">→</button>
    <button type="button" data-action="end" aria-label="Final position">⇥</button>
  </div>
  <figcaption>Round {headers.Round} · {headers.Result} (White won)<br /><a href={headers.Link}>View the game on Chess.com ↗</a></figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.game-replay').forEach(root => {
    const positions = JSON.parse(root.dataset.positions!);
    let index = Number(root.dataset.initial);
    const board = root.querySelector<HTMLElement>('.board')!;
    const controls = root.querySelector<HTMLElement>('.game-controls')!;
    controls.hidden = false;
    const render = () => {
      const position = positions[index];
      board.setAttribute('aria-label', `Chess position: ${position.label}, White at the bottom`);
      board.querySelectorAll<HTMLElement>('.game-square').forEach((square, i) => {
        const state = position.squares[i];
        const image = square.querySelector<HTMLImageElement>('.game-piece')!;
        if (state.image) image.src = state.image; else image.removeAttribute('src');
        image.hidden = !state.image;
        square.querySelector('.sr-only')!.textContent = state.name + '. ';
        square.title = state.name;
        square.classList.toggle('last-move', state.highlight);
      });
      root.querySelector('output')!.textContent = position.label;
      controls.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
        button.disabled = ['start', 'previous'].includes(button.dataset.action!) ? index === 0 : index === positions.length - 1;
      });
    };
    controls.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!button || button.disabled) return;
      const action = button.dataset.action;
      index = action === 'start' ? 0 : action === 'end' ? positions.length - 1 : index + (action === 'next' ? 1 : -1);
      render();
    });
    render();
  });
</script>
<style>
  .game-player { font-size: 12px; line-height: 1.5; margin: 10px 0; }
  .game-player span { color: var(--muted); }
  .board { grid-template-rows: repeat(8, minmax(0, 1fr)); }
  .game-square { display: flex; align-items: center; justify-content: center; position: relative; min-width: 0; min-height: 0; }
  .game-piece { display: block; width: 86%; height: 86%; object-fit: contain; }
  .game-piece[hidden] { display: none; }
  .last-move { box-shadow: inset 0 0 0 3px #315c8880; }
  .game-controls:not([hidden]) { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 14px; }
  button { background: transparent; border: 1px solid var(--border); color: var(--accent); border-radius: 4px; min-width: 36px; min-height: 40px; font-size: 18px; cursor: pointer; }
  button:disabled { opacity: .4; cursor: default; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  output { font-size: 13px; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
