---
import SiteLayout from '../layouts/SiteLayout.astro';
import { home } from '../data/home';
import Photo from '../components/Photo.astro';
---
<SiteLayout title="Andy — a little corner of the internet" active="home">
      <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy"><p class="eyebrow">A little corner of the internet</p><h1 id="intro-title">Hi, I'm Andy<span class="accent">.</span></h1><p class="intro">{home.intro}</p><div class="hero-links"><a href="/chess">Chess <span aria-hidden="true">↗</span></a><a href="/music">Music <span aria-hidden="true">↗</span></a><a href="/build">Things I build <span aria-hidden="true">↗</span></a></div></div>
        <figure class="hero-figure"><Photo photo={home.heroPhoto} variant="portrait" eager /><figcaption>A small space for the things I'm into.</figcaption></figure>
      </section>
      <section class="lately" aria-labelledby="lately-title"><div class="strip-heading"><h2 id="lately-title">Lately</h2><span>Updated {home.updated}</span></div><dl class="lately-grid">{home.lately.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></section>
<section class="section explore" aria-labelledby="explore-title">
  <p class="eyebrow">A few places to explore</p>
  <h2 id="explore-title">The things I'm into</h2>
  <div class="explore-rows">
    {home.areas.map(area => <a class="explore-row" href={area.href}>
      <h3>{area.title}</h3><p>{area.summary}</p><span aria-hidden="true">→</span>
    </a>)}
  </div>
</section>
</SiteLayout>
