---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '../styles/global.css';
import '../styles/project.css';
interface Props { title: string; summary: string; }
const { title, summary } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <title>{title} — Andy</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="container header">
      <a class="wordmark" href="/" aria-label="Andy, homepage">Andy<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#chess">Chess</a>
        <a href="/#music">Music</a>
        <a href="/#build">Things I build</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main" class="container project-detail"><slot /></main>
    <footer class="container footer">
      <a class="wordmark" href="/">Andy<span class="accent">.</span></a>
      <a href="#top">Back to the top ↑</a>
    </footer>
  </body>
</html>
